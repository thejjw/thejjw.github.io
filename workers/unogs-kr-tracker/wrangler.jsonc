{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unogs-kr-tracker",
  "main": "src/index.js",
  "compatibility_date": "2026-07-03",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "30 20 * * *"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "SNAPSHOTS",
      "id": "859f2d3507704740b729c9dca69a43a2"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://jjw.is-a.dev,https://thejjw.github.io"
  }
}
